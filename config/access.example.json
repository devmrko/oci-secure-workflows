      "public_key": "~/.ssh/oci-bastion.pub",
      "private_key": "~/.ssh/oci-bastion",
      "ttl_seconds": 10800
    }
  },
  "targets": {
    "dev-ssh": {
      "region": "ap-seoul-1", "mode": "forward",
      "host": "10.0.1.10", "port": 22, "local_port": 2222,
