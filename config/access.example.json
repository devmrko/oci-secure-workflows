    },
    "dev-web": {
      "region": "ap-seoul-1", "mode": "forward",
      "host": "10.0.1.10", "port": 8080, "local_port": 8080
    },
    "dev-db": {
      "region": "ap-seoul-1", "mode": "forward",
      "host": "10.0.1.20", "port": 1521, "local_port": 11521
    },
    "dev-rdp": {
      "region": "ap-seoul-1", "mode": "forward",
      "host": "10.0.1.30", "port": 3389, "local_port": 13389
    },
    "seoul-socks": {
      "region": "ap-seoul-1", "mode": "socks", "local_port": 1080
    }
  }
